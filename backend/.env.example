# ============================================================
#  PORTFOLIO APP — Environment Variables
#  For Cloud Deployment: Aiven MySQL + Render Backend
#
#  COPY THIS FILE:  cp .env.example .env
#  NEVER commit the actual .env to version control!
# ============================================================

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=production
# Render injects PORT automatically; keep this as fallback
PORT=5000

# ── Aiven MySQL (Free Tier) ───────────────────────────────────
# Get these from: Aiven Console → Your Service → Connection Info
# Format: mysql-xxxx-yourproject.aivencloud.com
DB_HOST=mysql-xxxx-yourproject.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password_here
DB_NAME=defaultdb

# SSL — Aiven REQUIRES SSL. Set to true.
DB_SSL=true
# Optional: path to Aiven CA certificate (downloaded from console)
# Leave blank to use Node.js system CA (works for Aiven without extra file)
DB_SSL_CA=
# Set to false ONLY if using a self-signed cert (not needed for Aiven)
DB_SSL_REJECT_UNAUTHORIZED=true

# ── JWT ───────────────────────────────────────────────────────
# Generate:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_char_hex_secret_generated_by_crypto_randomBytes
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────
# Add ALL frontend origins here (comma-separated, no trailing slash).
# Vercel *.vercel.app preview URLs are allowed automatically.
# Example:
#   https://my-portfolio.vercel.app,https://my-admin.vercel.app
CORS_ORIGINS=https://your-portfolio.vercel.app,https://your-admin.vercel.app

# ── File Upload ───────────────────────────────────────────────
# Max file size in bytes (5 MB default)
MAX_FILE_SIZE=5242880
# IMPORTANT: Render free tier has ephemeral storage.
# Files uploaded here will be LOST on restart/redeploy.
# For persistent uploads, integrate Cloudinary (see DEPLOYMENT.md).
UPLOAD_DIR=./uploads

# ── Bcrypt ────────────────────────────────────────────────────
# Higher = more secure but slower. 12 is good for production.
BCRYPT_ROUNDS=12

# ── Optional: Email (contact form notifications) ─────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# Gmail: use an App Password (not your real password)
# https://myaccount.google.com/apppasswords
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Portfolio Contact <your_email@gmail.com>"
NOTIFY_EMAIL=your_email@gmail.com
