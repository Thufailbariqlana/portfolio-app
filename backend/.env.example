# ============================================================
#  PORTFOLIO APP — Environment Variables
#  Stack: Vercel (Backend) + Aiven MySQL + Cloudinary
#
#  COPY THIS FILE:  cp .env.example .env
#  NEVER commit the actual .env to version control!
#  Set semua variabel ini di Vercel Dashboard → Settings → Environment Variables
# ============================================================

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Aiven MySQL ───────────────────────────────────────────────
# Ambil dari: Aiven Console → Your Service → Connection Info
DB_HOST=mysql-xxxx-yourproject.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password_here
DB_NAME=defaultdb

# SSL — Aiven WAJIB SSL
DB_SSL=true
# Path ke CA cert Aiven (opsional, kosongkan untuk pakai system CA)
DB_SSL_CA=
# false HANYA jika self-signed cert
DB_SSL_REJECT_UNAUTHORIZED=true

# ── JWT ───────────────────────────────────────────────────────
# Generate secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ganti_dengan_64_karakter_hex_random_dari_crypto_randomBytes
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────
# Daftar URL frontend yang diizinkan (comma-separated, tanpa trailing slash)
# WAJIB diisi agar admin & portfolio bisa konek ke API
# Contoh: https://my-portfolio.vercel.app,https://my-admin.vercel.app
CORS_ORIGINS=https://your-portfolio.vercel.app,https://your-admin.vercel.app

# ── Cloudinary ────────────────────────────────────────────────
# Ambil dari: https://cloudinary.com → Dashboard → API Keys
# WAJIB untuk upload foto profil, CV, gambar project, & sertifikat
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# ── Bcrypt ────────────────────────────────────────────────────
# 12 sudah cukup aman untuk production
BCRYPT_ROUNDS=12

# ── Email (notifikasi contact form) ──────────────────────────
# Opsional — jika tidak diisi, form tetap berfungsi tapi tidak ada email notifikasi
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# Gmail: gunakan App Password (bukan password utama)
# https://myaccount.google.com/apppasswords
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Portfolio Contact <your_email@gmail.com>"
NOTIFY_EMAIL=your_email@gmail.com
